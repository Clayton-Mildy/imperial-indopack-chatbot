# Copy to .env.local (git-ignored) and fill in the blanks. Never commit real values.

# Where the dashboard runs (npm run dev / npm start listen on 40070).
AUTH_URL=http://localhost:40070
AUTH_TRUST_HOST=true
# Min 32 random bytes: openssl rand -base64 32
AUTH_SECRET=

# The Imperial Indopack API. Server-side code may use API_INTERNAL_URL instead when the API is
# reachable at a different address from inside the dashboard's host.
NEXT_PUBLIC_API_URL=http://localhost:50070
# Must match the API's /app proxy prefix (api/src/app.ts).
NEXT_PUBLIC_BASE_PATH=/app

# API bearer key, server-side only (never exposed to the browser). Locally: SEED_API_KEY from api/.env.
API_SECRET_KEY=
