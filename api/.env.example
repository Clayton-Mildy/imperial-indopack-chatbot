# Database — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/imperial_indopack

# Internal API auth — secret shared between dashboard and API
# Generate: openssl rand -hex 32
API_SECRET_KEY=

# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: Claude subscription OAuth tokens (sk-ant-oat01-..., from `claude setup-token`) used
# instead of ANTHROPIC_API_KEY, which must then still be non-empty but is never sent. Strictly in
# number order: _1 serves every request until it hits its usage limit, then _2, and so on; the
# next request after _1's limit resets goes back to _1. Add as many as you like (_3, _4, ...).
# A legacy single ANTHROPIC_AUTH_TOKEN is treated as token 1 when no numbered token is set.
# CLAUDE_CODE_OAUTH_TOKEN_1=
# CLAUDE_CODE_OAUTH_TOKEN_2=
# ANTHROPIC_AUTH_TOKEN=
# OpenAI — embeddings for semantic product search. Optional: unset degrades to keyword search,
# and the seed-embeddings.ts step is skipped.
OPENAI_API_KEY=
# Dev mode: set true to route all Claude calls through the Claude Agent SDK,
# authenticated by your local Claude Code subscription login (no API key needed).
USE_CLAUDE_CLI=false
# Full-catalog system prompt (all products, cached via the Anthropic API) instead of top-20 RAG
# retrieval. Default on. Set to 0/false to roll back instantly to the legacy RAG path (no prompt
# caching) without a redeploy — just this edit + a service restart.
# FULL_CATALOG=false
# Model for the fit judge that checks each recommendation against the catalog (replies stay on
# Haiku). Default claude-sonnet-5-5; if the credential cannot use it (a 429 for every non-Haiku model
# on a Claude subscription token) the judge falls back to Haiku for 10 minutes at a time.
# JUDGE_MODEL=claude-sonnet-5-5
# Model that compares a customer's photo with the catalog's product photos, on the USE_CLAUDE_CLI
# route only (Claude Code model id or alias). Falls back to the reply model when unavailable.
# PHOTO_MATCH_MODEL=sonnet

# Where the per-month token-usage log is written (one file per month, local time). Defaults to
# ../logs/claude-usage relative to the service's working directory, i.e. C:\imperial-indopack\logs\claude-usage
# on the production PC - outside api\, so update.ps1 never deletes the history.
# CLAUDE_USAGE_LOG_DIR=C:\imperial-indopack\logs\claude-usage

# WhatsApp transport: chakra = ChakraHQ (BSP pass-through over Meta's Cloud API),
# meta = Meta Cloud API direct
# capture = LOCAL TESTING ONLY (refused when NODE_ENV=production): sends are appended to
# CAPTURE_LOG_PATH and inbound media is read from CAPTURE_MEDIA_DIR.
WHATSAPP_TRANSPORT=chakra
# CAPTURE_LOG_PATH=logs/whatsapp-capture.jsonl
# CAPTURE_MEDIA_DIR=scripts/qa/fixtures/files

# ─── Local dev overrides (API 50070, dashboard 40070) ────────────────────────
# Set these in your own .env instead of the production values elsewhere in this file
# (PORT, PUBLIC_BASE_URL, DASHBOARD_UPSTREAM, NODE_ENV, WHATSAPP_TRANSPORT, USE_CLAUDE_CLI).
# NODE_ENV=development            # capture transport and the HMAC bypass need a non-production env
# WHATSAPP_TRANSPORT=capture      # local testing: sends go to CAPTURE_LOG_PATH, no real number
# SKIP_HMAC_IN_DEV=true           # skip webhook signature check (also documented below)
# USE_CLAUDE_CLI=true             # route Claude calls through the local Claude Code login
# ANTHROPIC_API_KEY=unused-in-cli-mode   # must be non-empty under USE_CLAUDE_CLI, never sent
# SEED_API_KEY=                   # >= 32 chars (openssl rand -hex 32); `npm run seed:local` hashes it

# Meta / WhatsApp Cloud API (used when WHATSAPP_TRANSPORT=meta)
# VERIFY_TOKEN: any string you choose; must match Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=
# WEBHOOK_SECRET: App Secret — Meta for Developers → App Settings → Basic
META_WEBHOOK_SECRET=
# ACCESS_TOKEN: system-user token; fallback when phone_numbers.meta_access_token is unset
# Also used on the chakra transport, to download inbound photos/documents ChakraHQ's media API
# cannot serve (it 404s for them). Needs access to this WhatsApp Business Account. Optional.
META_ACCESS_TOKEN=
META_API_VERSION=v19.0
# Dev only: skip HMAC webhook signature verification (never in production)
# SKIP_HMAC_IN_DEV=true

# ChakraHQ (used when WHATSAPP_TRANSPORT=chakra). Send + receive route through Chakra.
# Point Chakra's PASS-THROUGH webhook at this API's /webhook (or /webhooks/whatsapp).
CHAKRA_BASE_URL=https://api.chakrahq.com
# PLUGIN_ID: Chakra dashboard → WhatsApp setup → ⋯ menu (top right) → Copy Plugin Id
CHAKRA_PLUGIN_ID=
# API_VERSION: the WhatsApp API version Chakra expects (per Chakra docs, e.g. v22.0)
CHAKRA_API_VERSION=v22.0
# ACCESS_TOKEN: Chakra dashboard → API Keys → create key → Access Tokens (Bearer)
CHAKRA_ACCESS_TOKEN=
# WEBHOOK_SECRET: HMAC secret from Chakra → Admin → Team → Secrets (inbound X-Chakra-Signature-256)
CHAKRA_WEBHOOK_SECRET=
# NOTE: the phone number id is the same Meta phone number id already stored per number
# (phone_numbers.phone_number_id) — no separate value needed.
# How often to backfill conversation history from Chakra (ms). 0 disables the timer; the
# "Sinkronkan sekarang" button in the dashboard works either way. Code default 3600000 (hourly).
# It is also how the bot learns what staff typed on the WhatsApp phone - those replies arrive only
# through this sync - so keep it short: 2 minutes means the bot can talk past staff for 2 minutes.
CHAKRA_SYNC_INTERVAL_MS=120000

# Message debounce — combine rapid customer texts into one AI reply (ms). Code default 8000.
TYPING_DEBOUNCE_MS=8000
# OPT-IN: shorter quiet window for the FIRST message of a batch only (a 2nd message
# re-arms the full window above). Lower = faster replies to lone messages, BUT a customer
# pausing between the two values gets two replies instead of one merged one — that can
# change what the AI answers. Unset = same as TYPING_DEBOUNCE_MS (no behavior change).
# TYPING_DEBOUNCE_FIRST_MS=4000
# A batch never waits longer than this from its first message, nor gathers more messages than this.
# TYPING_DEBOUNCE_MAX_WAIT_MS=30000
# TYPING_DEBOUNCE_MAX_MESSAGES=20
# Quiet window after the latest photo, so an album is answered in one turn (ms). Code default 5000.
# PHOTO_DEBOUNCE_MS=5000

# Re-warm the Anthropic prompt cache (full-catalog prefix, 1h TTL) on this interval so the
# first customer after a quiet gap skips the full-price cache write. 0 disables. Default 50min.
CACHE_WARMUP_INTERVAL_MS=3000000
# Per-attempt Anthropic API timeout (ms). Keep well above the ~30s normal turn. Default 90000.
ANTHROPIC_TIMEOUT_MS=90000

# Public base URL WhatsApp fetches outbound media links from — MUST be publicly reachable
# (tunnel hostname / prod domain, never localhost, or media sends silently fail)
PUBLIC_BASE_URL=http://localhost:50070
# Browser origin allowed to call this API cross-origin in production (the dashboard's public URL).
# Empty in production blocks all cross-origin browser calls. With the dashboard proxied under
# /app on this same host, that origin IS PUBLIC_BASE_URL.
DASHBOARD_ORIGIN=

# Where this API forwards /app/* - the dashboard's loopback address. The PC has one public
# hostname (the Cloudflare Tunnel, pointed here), so the dashboard rides through this API rather
# than getting a second hostname: push subscriptions are origin-scoped, and one name is one name
# to keep in sync. Set to empty to disable the proxy and keep the dashboard purely local.
DASHBOARD_UPSTREAM=http://127.0.0.1:40070

# ─── Staff notification ──────────────────────────────────────────────────────
# All optional. With none of these set, an escalation reaches a human only when someone opens
# the dashboard - which is how it worked before these existed.
#
# Web push for the staff PWA. Generate the pair once, anywhere: npx web-push generate-vapid-keys
# Rotating it invalidates every existing subscription; staff must re-enable notifications.
# Note for iOS: push needs 16.4+ AND the site added to the Home Screen - a normal Safari tab
# cannot receive one, no matter what is configured here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Staff WhatsApp number pinged on escalation. Covers phones push cannot reach and doubles as the
# fallback when a subscription has silently expired. Empty = off.
ESCALATION_NOTIFY_WA=
# Remind staff about an escalation still sitting unanswered, checked every INTERVAL. How long counts as
# unanswered is set in the dashboard (Pengaturan, Tim & notifikasi; default 30 minutes): AFTER_MS is only
# an on/off switch (0 = off, any other value = on). 0 on either disables the reminder.
ESCALATION_NUDGE_AFTER_MS=1800000
ESCALATION_NUDGE_INTERVAL_MS=600000

# Background pass that reads each chat once the customer has been quiet 5 minutes - replied to by the
# bot or not, AI toggle on or off - and fills the lead: Hot/Cold, name, business name, brands and
# items, kind (lead, kurir, supplier ...), stage (Contacted / Won / Lost, each only with a customer
# message as proof) and orders. Fills blanks only, never over a staff edit; never sets a deal value.
# One Haiku call per conversation read; LEAD_INSIGHTS_BATCH per tick. 0 disables.
# LEAD_INSIGHTS_INTERVAL_MS=600000
# LEAD_INSIGHTS_BATCH=20
# LEAD_STAGE_AI=0 stops the pass writing kind, stage and orders; the fills above go on.
# LEAD_STAGE_AI=0

# Comma-separated WhatsApp numbers allowed to type /new, which makes the AI forget that thread
# and clears its CRM state (contact profile, lead status back to Baru). Resets the SENDER's own
# conversation only. Empty = off, and a customer typing "/new" is then just a message.
# Testing knob: anyone holding a listed handset can wipe that contact's profile. Leave it empty
# in production unless a reset is actually being run.
RESET_COMMAND_NUMBERS=

# Server
PORT=50070
NODE_ENV=production
# Fastify log level (trace, debug, info, warn, error). Default info.
# LOG_LEVEL=info

# scripts/migrate.ts (node dist-scripts/migrate.js) reads migrations from here. Default ./migrations,
# where the deploy bundle puts them; from a source checkout use src/db/migrations.
# MIGRATIONS_DIR=src/db/migrations

# Seed-only (scripts/seed.ts) — the first dashboard admin. Set these before running the bootstrap
# seed; the script's own fallbacks are deliberately weak and must never reach production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
