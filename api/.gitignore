node_modules/
dist/
dist-scripts/
.env
.env.local
.env.bak*
*.tsbuildinfo
*.db
logs/
.DS_Store
scripts/_tmp_*

# Keep the vendored scrape xlsx, ignore reseed output written beside it
scripts/data/*
!scripts/data/*.xlsx

# Ignore uploaded files but keep the folder structure
uploads/*
!uploads/images/
!uploads/catalogs/
uploads/images/*
!uploads/images/.gitkeep
uploads/catalogs/*
!uploads/catalogs/.gitkeep
# Nothing else under uploads/ is ever tracked: price-list PDFs, photos and customer files are what
# staff and customers upload at runtime.
!scripts/data/catalog-family-map.json

# ingest_pricelist.py imports ingest_catalog.py
scripts/__pycache__/

# Generated by the conversation QA harness (scripts/qa/setup.ts)
uploads/catalogs/qa-*.pdf
