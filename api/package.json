{
  "name": "imperial-indopack-api",
  "version": "0.1.0",
  "description": "Imperial Indopack WhatsApp AI Agent — Backend API",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts scripts/backfill-leads.ts scripts/backfill-lead-stages.ts scripts/backfill-outbound-senders.ts scripts/repair-lead-sync-order.ts scripts/seed-embeddings.ts scripts/seed-default-prompt.ts scripts/reseed-prompt-defaults.ts scripts/push-test.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-scripts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "catalog:demo": "tsx scripts/load-demo-catalog.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:setup": "tsx scripts/qa/setup.ts",
    "qa:api": "tsx scripts/qa/start-api.ts",
    "qa:run": "tsx scripts/qa/run.ts",
    "qa:say": "tsx scripts/qa/say.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.208",
    "@anthropic-ai/sdk": "^0.111.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/http-proxy": "^11.6.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "bcryptjs": "^3.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.43.0",
    "fastify": "^5.8.0",
    "pg": "^8.13.0",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  }
}
